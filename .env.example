# EchoMedia Automations — environment template.
# Copy to .env and fill in real values. NEVER commit .env (see .gitignore).
# Scope: v2/M5 cut Ssemble/Reap/Postiz/Ayrshare-as-default from v1 — this
# file lists only what v1's actual build (Vizard + Mock, Upload-Post + Mock)
# needs. Ayrshare/Postiz remain documented fallback options, not built.

# ---- Twitch (RC-1, RC-5) ----
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_EVENTSUB_SECRET=

# ---- Clipper (RC-2 · v2 M5: vizard + mock only in v1) ----
CLIP_PROVIDER=mock
VIZARD_API_KEY=

# ---- Storage ----
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- Trello — the Review Gateway (RC-3, RC-6/C2) ----
TRELLO_KEY=
TRELLO_TOKEN=
# App secret — used to verify the X-Trello-Webhook HMAC-SHA1 signature.
# Finding C2: never act on a webhook payload without verifying this first.
TRELLO_API_SECRET=
# Must exactly match the callback URL registered with Trello — it's part of
# the HMAC input (body + callbackURL), so a mismatch breaks verification.
TRELLO_WEBHOOK_CALLBACK_URL=

# ---- Poster (RC-4, RC-6 · v2 M5: uploadpost + mock only in v1) ----
POSTER_DRIVER=mock
UPLOADPOST_API_KEY=

# ---- Billing ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- n8n ----
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=UTC

# ---- Local dev storage only — infra/docker-compose.yml's MinIO stand-in.
# Never used against real client data; real deployments use R2 above. ----
MINIO_ROOT_USER=echomedia
MINIO_ROOT_PASSWORD=echomedia_local_dev

# ---- Health digest heartbeat (finding L2) ----
# e.g. a healthchecks.io check URL, pinged on every successful digest run
# so a dead cron reads as "silence" instead of falsely reading as "healthy".
HEARTBEAT_PING_URL=
